<head>
    <link rel="stylesheet" href="/css/PrintSetting.css">
</head>
<body>
    <section class="home" style="overflow-y: auto;">

        <div class="text" style="font-size: 15px;">
            <span>Home</span> &gt; <span>Printer Setting</span>
        </div>
        <div class="text" style="font-weight: bold; text-align:center;color:black;">Printer Setting</div>

        <div class="container">
            <div class="settingbox">
                <form style="margin-bottom: 25px; margin-top: 25px">
                    <text class="text" style="font-size: 22px;">Upload your file here</text>
                    <input type="file" id="fileInput" name="file">
                </form>
                <div style="margin-bottom: 25px;">
                    <span class="text" style="font-size: 22px; padding-right: 25px;">Choose paper size </span>
                    <span class="text" style="font-size: 22px; padding-right: 25px;">A3</span><input type="checkbox">
                    <span class="text" style="font-size: 22px; padding-right: 25px;">A4</span><input type="checkbox">
                </div>
                <div style="margin-bottom: 25px;">
                    <span class="text" style="font-size: 22px; padding-right: 25px;">One-sided</span><input type="checkbox">
                    <span class="text" style="font-size: 22px; padding-right: 25px;">Double-sided</span><input type="checkbox">
                </div>
                <div style="margin-bottom: 25px;">
                    <span class="text" style="font-size: 22px; padding-right: 25px;">Enter number of copies</span>
                    <input type="number">
                </div>
                <div style="margin-bottom: 25px;">
                    <span class="text" style="font-size: 22px; padding-right: 25px;">Color printed</span>
                    <input type="checkbox">
                </div>
            </div>

            <div class="infobox">
                <div>
                    <span class="text" style="font-size: 20px;padding-left:60px;padding-right:1px;">Printer's Info</span>
                </div>
                <div style="margin-bottom: 15px; margin-top: 10px">
                    <span class="text" style="font-size: 15px;padding-left:5px;padding-right:1px;">Model: LBP 2900</span>
                </div>
                <div style="margin-bottom: 15px;">
                    <span class="text" style="font-size: 15px;padding-left:5px;padding-right:1px;">A3 paper sheets: 20</span>
                </div>
                <div style="margin-bottom: 15px;">
                    <span class="text" style="font-size: 15px;padding-left:5px;padding-right:1px;">A4 paper sheets: 20</span>
                </div>
                <div style="margin-bottom: 15px;">
                    <span class="text" style="font-size: 15px;padding-left:5px;padding-right:1px;">Campus name: TP.HCM</span>
                </div>
                <div style="margin-bottom: 15px;">
                    <span class="text" style="font-size: 15px;padding-left:5px;padding-right:1px;">Building: 8C</span>
                </div>
                <div style="margin-bottom: 15px;">
                    <span class="text" style="font-size: 15px;padding-left:5px;padding-right:1px;">Room: LEW302-Allbert Einstein</span>
                </div>
                <div style="margin-bottom: 16px;">
                    <span class="text" style="font-size: 15px;padding-left:5px;padding-right:1px;">Status: active</span>
                </div>
            </div>
        </div>
    </section>
</body>
