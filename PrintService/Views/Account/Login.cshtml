<!-- Views/Account/Login.cshtml -->
@model Account
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: url('/img/SIU.png') no-repeat center center;
            background-size: cover; /* Adjust as needed */
            height: 100vh;
            margin: 0;
            position: relative;
        }

            body::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(255, 255, 255, 0.5); /* Adjust transparency for fade */
                z-index: 0;
            }

        /* Ensure header and other content stay on top */
        .header {
            position: relative;
            z-index: 2; /* Keep the header above the faded background */
            background-color: #007bff; /* Match Bootstrap's primary color */
            color: white;
            padding: 20px 0;
            text-align: center;
        }

        .login-container {
            position: relative;
            z-index: 1; /* Keep form above the faded background */
            max-width: 400px;
            margin: auto;
            margin-top: 10%;
            padding: 20px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            text-align: center;
            background-color: #f8f9fa;
            padding: 10px 0;
        }
    </style>

</head>
<body>
    <!-- Header -->
    <div class="header">
        <h1>Welcome to HCMSIU_SSPS</h1>
    </div>

    <!-- Login Form -->
    <div class="login-container">
        <h2 class="text-center mb-4">Login</h2>
        <form asp-action="Login" asp-controller="Account" method="post">
            <div class="mb-3">
                <label for="text" class="form-label">Student Id</label>
                <input type="text" class="form-control" id="studentid" asp-for="AccountId" placeholder="Enter your student id">
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" asp-for="Password" placeholder="Enter your password">
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary">Log in</button>
            </div>
            <div class="text-center mt-3">
                <a href="#" class="text-decoration-none">Forgot your password?</a>
            </div>
        </form>
    </div>

    <!-- Footer -->
    <div class="footer bg-primary text-white">
        <div>Copyright © 2024 SIU The Sai Gon International University</div>
        <div>All Rights Reserved</div>
        <div>Address: 8C Tong Huu Dinh, Thao Dien Ward, Thu Duc City, Ho Chi Minh City</div>
    </div>

    <!-- Bootstrap JS (Optional) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
