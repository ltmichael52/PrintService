<!-- Views/Account/Login.cshtml -->
@model Account
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" href="@Url.Content("~/img/image.png")" type="image/x-icon">
</head>
<body style="
        background: url('/img/SIU.png') no-repeat center center fixed;
        background-size: cover;
        position: relative;
    "
      class="d-flex flex-column min-vh-100">

    <!-- Background Overlay -->
    <div style="
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.5);
            z-index: 0;
        ">
    </div>

    <!-- Header -->
    <header class="bg-primary text-white text-center py-3" style="z-index: 1; position: relative;">
        <h1>Welcome to HCMSIU_SSPS</h1>
    </header>

    <!-- Login Form -->
    <main class="container d-flex justify-content-center align-items-center flex-grow-1" style="z-index: 1; position: relative;">
        <div class="card shadow-lg p-4" style="width: 100%; max-width: 400px;">
            <h2 class="text-center mb-4">Login</h2>
            <form asp-action="Login" asp-controller="Account" method="post">
                <div class="mb-3">
                    <label for="studentid" class="form-label">Student ID</label>
                    <input type="text" class="form-control" id="studentid" asp-for="AccountId" placeholder="Enter your student ID">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" asp-for="Password" placeholder="Enter your password">
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Log in</button>
                </div>
                <div class="text-center mt-3">
                    <a href="#" class="text-decoration-none">Forgot your password?</a>
                </div>
            </form>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-primary text-white text-center py-3" style="z-index: 1; position: relative;">
        <div>Copyright © 2024 SIU The Sai Gon International University</div>
        <div>All Rights Reserved</div>
        <div>Address: 8C Tong Huu Dinh, Thao Dien Ward, Thu Duc City, Ho Chi Minh City</div>
    </footer>

    <!-- Bootstrap JS (Optional) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
