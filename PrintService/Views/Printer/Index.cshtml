@using PrintService.ViewModels;
@model List<ShowPrinter>
@{
    ViewData["Title"] = "CHOOSE PRINTER";
}

<!-- CHOOSE PRINTER -->

<section class="home" style="overflow-y: auto;">
    <div class="text" style="font-size: 15px;">
        <span>Home</span> &gt; <span>Choose a printer</span>
    </div>
    <div class="text" style="font-weight: bold; text-align:center;color:black;">Choose a printer</div>
    <div class="container">
        <button class="filterbutton">
            <img src="~/img/filter.png" style="height:25px;width:25px" />
            Filter results
        </button>
        <input class="searchbox" placeholder="Search" />
    </div>
    <div class="printercontainer">
        <div class="row">
            @foreach (ShowPrinter printer in Model)
            {
                <div class="printerbox">
                    <a asp-controller="PrintProcess" asp-action="PrintConfig" asp-route-printerId="@printer.PrinterId" class="printer-link">
                        <img src="img/printer.png" class="printerimg" alt="Printer 1">
                        <div class="modeltext">
                            <span>Model: @printer.PrinterModel</span>
                        </div>
                        <div class="container" style="gap:10px">
                            <div class="leftinfo">
                                <div style="padding-right:0px;">
                                    <span>Campus: @printer.CampusName</span>
                                </div>
                                <div>
                                    <span>Building: @printer.BuildingName</span>
                                </div>
                                <div>
                                    <span>Room: @printer.RoomName</span>
                                </div>
                            </div>
                            <div class="rightinfo">
                                <div style="padding-right:0px;">
                                    <span>Queuing: @printer.AmountInQueue</span>
                                </div>
                                <div>
                                    <span>Status: @(printer.IsActive ?? false ? "on" : "off")</span>
                                </div>
                                <div>
                                    <span>A3: @printer.A3Amount and A4: @printer.A4Amount</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
