@using PrintService.Payments
@model PaymentRequest

<head>
    <link rel="stylesheet" href="/css/Recharge.css">
</head>
<section class="home" style="overflow-y: auto;">

    <div class="text" style="font-size: 15px;">
        <span>Home</span> &gt; <span>Recharge Balance</span>
    </div>
    <div class="text" style="font-weight: bold; text-align:center;color:black;">Recharge Balance</div>

    <!-- Form bắt đầu -->
    <form asp-action="CreatePaymentUrl" method="post">

        <div class="container">
            <div class="rechargebox">
                <div style="margin-bottom:20px;margin-top:10px;">
                    <span class="text" style="font-size:22px;padding-left:30px">Enter the amount (VNĐ)</span>
                </div>
                <div style="margin-bottom:10px">
                    <input asp-for="Amount" type="number" placeholder="Type your amount..." name="Amount" required min="5000" max="30000000" />
                </div>
                <div style="margin-bottom:10px">
                    <span class="text" style="font-size:17px;color:lightgray;padding-left:30px">Current Wallet balance: 10,000 VND</span>
                </div>
                <div style="margin-left:30px;border-bottom:2px solid #c1c1c1;padding-bottom:33px;">
                    <button type="button" class="btnprice" onclick="setAmount(10000)">
                        10.000 VNĐ
                    </button>
                    <button type="button" class="btnprice" onclick="setAmount(20000)">
                        20.000 VNĐ
                    </button>
                    <button type="button" class="btnprice" onclick="setAmount(50000)">
                        50.000 VNĐ
                    </button>
                    <button type="button" class="btnprice" onclick="setAmount(100000)">
                        100.000 VNĐ
                    </button>
                    <button type="button" class="btnprice" onclick="setAmount(200000)">
                        200.000 VNĐ
                    </button>
                    <button type="button" class="btnprice" onclick="setAmount(500000)">
                        500.000 VNĐ
                    </button>
                </div>
                <div style="margin-bottom:10px;margin-top:10px">
                    <span class="text" style="font-size:22px;color:black;padding-left:30px">Payment Method</span>
                </div>
                <div style="margin-left:30px">
                    <button type="button" class="btnmethod" onclick="setPaymentMethod('Momo')">
                        Momo
                        <img class="logoimg" src=~/img/momo.png />
                    </button>
                    <button type="button" class="btnmethod" onclick="setPaymentMethod('VnPay')">
                        VNPAY
                        <img class="logoimg" src=~/img/vnpay.jpg />
                    </button>
                    <button type="button" class="btnmethod" style="margin:0px;" onclick="setPaymentMethod('Paypal')">
                        PayPal
                        <img class="logoimg" src=~/img/paypal.png />
                    </button>
                </div>
                <!-- Ẩn input để submit Payment Method -->
                <input type="hidden" name="PaymentMethod" id="PaymentMethod" required />
            </div>

            <div class="rechargeinfo">
                <div class="rechargeinfobox">
                    <div style="margin-bottom:10px">
                        <span class="text" style="font-size:18px;padding-left:10px;padding-right:0px;">Rechare: <span id="recharge-amount-display">10.000 VNĐ</span></span>
                    </div>
                    <div style="margin-bottom:10px; border-bottom:2px solid #c1c1c1;padding-bottom:10px">
                        <span class="text" style="font-size:18px; padding-left:10px; padding-right:0px; color:gray;">Recharge fee: FREE</span>
                    </div>
                    <div style="margin-bottom:10px">
                        <span class="text" style="font-size:18px;padding-left:10px;padding-right:0px;color: black">Total payment : <span id="total-payment-display">10.000 VNĐ</span></span>
                    </div>
                </div>
                <div class="rechargelimitinfobox">
                    <div style="margin-bottom:10px">
                        <span class="text" style="font-size:12px;padding-left:10px;padding-right:0px;color:red;">Minimum recharge amount is 5,000 VNĐ.</span>
                    </div>
                    <div style="margin-bottom:10px">
                        <span class="text" style="font-size:12px;padding-left:10px;padding-right:0px;color:red;">Maximum recharge amount is 30,000,000 VNĐ.</span>
                    </div>
                </div>
                <div class="policy">
                    By clicking 'Recharge Now,' you agree to abide by SIUPAY's
                    <span style="color:#2c7adf">Terms of Use</span>
                    and
                    <span style="color:#2c7adf">Privacy Policy.</span>
                </div>
                <div style="margin-top:30px">
                    <button type="submit" class="btnrecharge">
                        Recharge Now
                    </button>
                </div>
            </div>
        </div>

    </form> 

</section>

<script>
    // Hàm đặt giá trị cho ô nhập số tiền
    function setAmount(amount) {
        document.querySelector('input[name="Amount"]').value = amount;
        document.getElementById('recharge-amount-display').innerText = formatCurrency(amount) + ' VNĐ';
        document.getElementById('total-payment-display').innerText = formatCurrency(amount) + ' VNĐ';
    }

    // Hàm đặt phương thức thanh toán
    function setPaymentMethod(method) {
        document.getElementById('PaymentMethod').value = method;
    }

    // Hàm định dạng số tiền thành VNĐ
    function formatCurrency(amount) {
        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount).replace('₫', '').trim();
    }
</script>
