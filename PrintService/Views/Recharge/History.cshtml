@using PrintService.ViewModels
@model List<RechargeHistory>

<section class="home" style="overflow-y: auto;">

    <div class="text" style="font-size: 15px;">
        <span>Home</span> &gt; <span>Recharge History</span>
    </div>
    <div class="text" style="font-weight: bold; text-align:center;color:black;">Printing Log</div>

    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="card text-center" style="width:98%">
            <div class="card-header">
                <div class="row">
                    <div class="col">
                    </div>
                    <div class="col-auto">
                        <div class="card-tools">

                            <!-- Modal -->
                            <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                                <div class="modal-dialog" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="exampleModalLabel">Tạo cơ sở mới</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="form-group">
                                                <label class="control-label"><strong>Tên cơ sở<span class="text-danger"> *</span></strong></label>
                                                <input class="form-control" id="tencsCreate" placeholder="Elliot" />
                                                <span class="text-danger" id="tencsSpanCreate"></span>
                                            </div>
                                            <div class="form-group">
                                                <label class="control-label"><strong>Địa chỉ<span class="text-danger"> *</span></strong></label>
                                                <input class="form-control" id="diachiCreate" placeholder="2A PhamVanDong" />
                                                <span class="text-danger" id="diachiSpanCreate"></span>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" id="btnCsCreate" class="btn btn-primary">Tạo</button>
                                            <button type="button" class="btn btn-danger" data-dismiss="modal">Đóng</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="bs-stepper linear">
                    <div class="bs-stepper-content">

                        <div id="PartialViewCoSo">

                            <table class="table table-striped">
                                <thead class="text-center">
                                    <tr>
                                        <th>Recharge ID</th>
                                        <th>FullName</th>
                                        <th>Amount</th>
                                        <th>Method</th>
                                        <th>Recharge Date</th>
                                        <th>Is Colored</th>
                                    </tr>
                                </thead>
                                <tbody class="text-center">

                                    @foreach (var prntLog in Model)
                                    {
                                        <tr>
                                            <td>@prntLog.RechargeId</td>
                                            <td>@prntLog.Student.FullName</td>
                                            <td>@prntLog.Amonut.ToString("#,##") VNĐ</td>
                                            <td>@prntLog.RechargeMethod</td>
                                            <td>@prntLog.RechargedDate.ToLocalTime()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>