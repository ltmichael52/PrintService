<head>
    <link rel="stylesheet" href="/css/PurchasePaperSheets.css">
</head>
<body>
    <section class="home" style="overflow-y: auto;">
    <div class="text" style="font-size: 15px;">
            <span>Home</span> &gt; <span>Purchase Paper Sheets</span>
    </div>
        <div class="text" style="font-weight: bold; text-align:center;color:black;">Purchase Paper Sheets</div>
        <div class="balancebox">
            <div class="text" style="margin-bottom:10px;margin-top:10px;margin-left:37px;font-size:17px;padding-left:0px;padding:0px">Account balance: @String.Format("{0:N0}", Model.AccountBalance)</div>
            <div style="margin-bottom:10px;margin-left:35px">
                <span class="text" style="font-size:17px;padding-left:0px;padding:0px">A3 balance: @Model.A3Balance</span> &nbsp; | &nbsp;
                <span class="text" style="font-size:17px;padding-left:0px;padding:0px">A4 balance: @Model.A4Balance</span>
            </div>
        </div>

        <div class="purchasebox">
            <div class="container">
                <div class="paper">
                    <img class="paperimg" src="~/img/A4.png" />
                    <div style="margin-top:10px;">
                        <span>@String.Format("{0:N0}", Model.A4Price) Đ/ 1 sheet</span>
                    </div>
                </div>
                <div class="paper">
                    <img class="paperimg" src="~/img/A3.png" />
                    <div style="margin-top:10px;">
                        <span>@String.Format("{0:N0}", Model.A3Price) Đ/ 1 sheet</span>
                    </div>
                </div>
            </div>

    <form method="post" asp-action="Index">
        <input type="hidden" name="A3Quantity" id="A3Quantity" />
        <input type="hidden" name="A4Quantity" id="A4Quantity" />
        <input type="hidden" name="TotalAmount" id="TotalAmount" />

                <div style="margin-top: 30px;">
                    <span class="text" style="font-size: 20px;padding-right:10px">A4 Paper sheets:</span>
                    <input type="number" id="quantityA4" value="0" min="0" style="width: 60px; text-align: center; margin: 0 10px; font-size: 20px;" onchange="calculateTotal()">
        </div>
                <div style="margin-top: 10px;">
                    <span class="text" style="font-size: 20px;padding-right:10px">A3 Paper sheets:</span>
                    <input type="number" id="quantityA3" value="0" min="0" style="width: 60px; text-align: center; margin: 0 10px; font-size: 20px;" onchange="calculateTotal()">
        </div>

                <div style="margin-top: 10px; margin-bottom:10px;">
                    <span class="text" style="font-size:25px;margin-left:660px;font-weight:bold">Total bill : <span id="totalAmount">0 VNĐ</span></span>
        </div>

                <div class="button-container" style="display: flex; justify-content: flex-end; margin-top: 20px;">
                    <button type="submit" class="buybtn" style="font-size: 20px; color: white;">Buy</button>
                </div>
        </button>
    </form>
        </div>
        @if(ViewBag.InvalidPaper == true)
 {
     <script>
         document.getElementById("alertBox").style.display = "block";
      </script>
     <div id="alertBox" class="alert" role="alert" style="
         width: 50%;
         background-color: #ffffff;
         border: 1px solid #ddd;
         padding: 20px;
         border-radius: 5px;
         position: fixed;
         top: 10%;
         left: 50%;
         transform: translateX(-50%);
         box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
         ">
         <h4 class="alert-heading" style="color: red; margin: 0; font-weight: bold;">Insufficient Account Balance Alert</h4>
                <p style="margin: 10px 0;">
                    Your account does not have enough funds to complete the purchase. Please recharge your account to proceed.
                </p>

         <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px;">
             <a href="#" id="closeButton" style="background-color: #ffffff; color: black; text-decoration: none; padding: 5px 15px; border: 1px solid black; border-radius: 3px;">Close</a>
             <a asp-controller="Recharge" asp-action="Index" style="background-color: #007bff; color: black; text-decoration: none; padding: 5px 15px; border: 1px solid #007bff; border-radius: 3px;">Recharge</a>
         </div>
     </div>
 }
        @if (ViewBag.SuccessPurchase == true)
        {
            <script>
                document.getElementById("successBox").style.display = "block";
            </script>
            <div id="successBox" class="alert" role="alert" style="
                 width: 50%;
                 background-color: #ffffff;
                 border: 1px solid #ddd;
                 padding: 20px;
                 border-radius: 5px;
                 position: fixed;
                 top: 10%;
                 left: 50%;
                 transform: translateX(-50%);
                 box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
                ">
                <h4 class="alert-heading" style="color: green; margin: 0; font-weight: bold;">Purchase Successful</h4>
                <p style="margin: 10px 0;">
                    Your purchase has been completed successfully. Thank you for shopping!
                </p>
                <div style="display: flex; justify-content: center; align-items: center; margin-top: 20px;">
                    <a href="#" id="closeSuccessButton" style="background-color: #ffffff; color: black; text-decoration: none; padding: 5px 15px; border: 1px solid black; border-radius: 3px;">Close</a>
                </div>
            </div>
        }

</section>

@section Scripts {
    <script>
            var closeButton = document.getElementById("closeButton");
            if (closeButton) {
                closeButton.addEventListener("click", function (event) {
                    event.preventDefault();
                    document.getElementById("alertBox").style.display = "none";
                });
            }

            var closeSuccessButton = document.getElementById("closeSuccessButton");
            if (closeSuccessButton) {
                closeSuccessButton.addEventListener("click", function (event) {
                    event.preventDefault();
                    document.getElementById("successBox").style.display = "none";
                });
            }


        function increase(id) {
            let input = document.getElementById(id);
            input.value = parseInt(input.value) + 1;
        }

        function decrease(id) {
            let input = document.getElementById(id);
            if (input.value > 0) {
                input.value = parseInt(input.value) - 1;
            }
        }

            // Hàm tính tổng
            function calculateTotal() {
            // Get quantities and prices
                var quantityA3 = parseInt(document.getElementById('quantityA3').value) || 0;
                var priceA3 = @Model.A3Price;

                // Lấy số lượng và giá cho A4
                var quantityA4 = parseInt(document.getElementById('quantityA4').value) || 0;
                var priceA4 = @Model.A4Price;

            // Calculate total
                var total = (quantityA3 * priceA3) + (quantityA4 * priceA4);
            document.getElementById('totalAmount').textContent = total.toLocaleString() + " VND";

            // Update hidden inputs
                document.getElementById('A3Quantity').value = quantityA3;
                document.getElementById('A4Quantity').value = quantityA4;
                document.getElementById('TotalAmount').value = total;
            }
    </script>
}
</body>
