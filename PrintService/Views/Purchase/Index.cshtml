<head>
    <link rel="stylesheet" href="/css/PurchasePaperSheets.css">
</head>
<body>
    <section class="home" style="overflow-y: auto;">

        <div class="text" style="font-size: 15px;">
            <span>Home</span> &gt; <span>Purchase Paper Sheets</span>
        </div>
        <div class="text" style="font-weight: bold; text-align:center;color:black;">Purchase Paper Sheets</div>
        <div class="balancebox">
            <div class="text" style="margin-bottom:10px;margin-top:10px;margin-left:37px;font-size:17px;padding-left:0px;padding:0px">Account balance: 2.000.000 VNĐ</div>
            <div style="margin-bottom:10px;margin-left:35px">
                <span class="text" style="font-size:17px;padding-left:0px;padding:0px">A3 balance: 20 </span> &nbsp; | &nbsp;
                <span class="text" style="font-size:17px;padding-left:0px;padding:0px">A4 balance: 20 </span>
            </div>
        </div>
        <div class="purchasebox">
            <div class="container">
                <div class="paper">
                    <img class="paperimg" src="~/img/A4.png" />
                    <div style="margin-top:10px;">
                        <span>1000 Đ/ 1 sheet</span>
                    </div>
                </div>
                <div class="paper">
                    <img class="paperimg" src="~/img/A3.png" />
                    <div style="margin-top:10px;">
                        <span>2000 Đ/ 1 sheet</span>
                    </div>
                </div>
            </div>
            <div style="margin-top: 30px;">
                <span class="text" style="font-size: 20px;padding-right:10px">A4 Paper sheets:</span>
                <input type="number" value="1" min="1" style="width: 60px; text-align: center; margin: 0 10px; font-size: 20px;">
            </div>
            <div style="margin-top: 10px;">
                <span class="text" style="font-size: 20px;padding-right:10px">A3 Paper sheets:</span>
                <input type="number" value="1" min="1" style="width: 60px; text-align: center; margin: 0 10px; font-size: 20px;">
            </div>
            <div style="margin-top: 10px; margin-bottom:10px;">
                <span class="text" style="font-size:25px;margin-left:660px;font-weight:bold">Total bill : 3.000 VNĐ</span>
            </div>

        </div>
        <button class="buybtn">Buy</button>
    </section>
</body>
