@model int

<section class="home" style="overflow-y: auto;">

    <div class="text" style="font-size: 15px;">
        <span>Home</span> &gt; <span>Printer Setting</span>&gt; <span>Printer Setting Success</span>

    </div>
    <div class="text" style="font-weight: bold; text-align:center;color:black;">Printer Setting Success</div>
        <div style="margin-left: 18%">
    <p>Your print request has gotten into the queue</p>
    <p>Id request: @Model</p>
    <p>Follow status in printing history</p>
</div>
    <div style="text-align: left;">
        <a asp-controller="Printer" asp-action="Index"
           class="btn-info btn-lg" style="margin-top:200px;margin-left:12%;padding: 10px 20px; font-size: 16px; border: none; border-radius: 5px; cursor: pointer;">
            Back
        </a>
    </div>

</section>