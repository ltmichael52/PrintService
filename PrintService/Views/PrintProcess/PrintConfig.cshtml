@model PrintService.ViewModels.PrintConfig

@{
    ViewData["Title"] = "Print Config";
    Layout = null;
}


<h1>Print Config</h1>

<form asp-action="PrintConfig" asp-controller="PrintProcess" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="PrinterModel">Printer Model</label>
        <input type="text" id="PrinterModel" name="PrinterModel" class="form-control" value="@Model.PrinterModel" readonly />
    </div>

    <div class="form-group">
        <label for="A3Amount">A3 Amount</label>
        <input type="number" id="A3Amount" name="A3Amount" class="form-control" value="@Model.A3Amount" readonly />
    </div>

    <div class="form-group">
        <label for="A4Amount">A4 Amount</label>
        <input type="number" id="A4Amount" name="A4Amount" class="form-control" value="@Model.A4Amount" readonly />
    </div>

    <div class="form-group">
        <label for="CampusName">Campus Name</label>
        <input type="text" id="CampusName" name="CampusName" class="form-control" value="@Model.CampusName" readonly />
    </div>

    <div class="form-group">
        <label for="BuildingName">Building Name</label>
        <input type="text" id="BuildingName" name="BuildingName" class="form-control" value="@Model.BuildingName" readonly />
    </div>

    <div class="form-group">
        <label for="Room">Room</label>
        <input type="text" id="Room" name="Room" class="form-control" value="@Model.Room" readonly />
    </div>

    <div class="form-group">
        <label for="PrinterID">Printer ID</label>
        <input type="number" id="PrinterID" name="PrinterID" class="form-control" value="@Model.PrinterID" readonly />
    </div>

    <div class="form-group">
        <label for="PaperTypeID">Paper Type</label>
        <input type="number" id="PaperTypeID" name="PaperTypeID" class="form-control" value="@Model.PaperTypeID" />
    </div>

    <div class="form-group">
        <label for="file">File</label>
        <input type="file" id="file" name="File" class="form-control" />
    </div>

    <div class="form-group">
        <label for="Colored">Colored</label>
        <select id="Colored" name="Colored" class="form-control">
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
    </div>

    <div class="form-group">
        <label for="NumberOfCopies">Number of Copies</label>
        <input type="number" id="NumberOfCopies" name="NumberOfCopies" class="form-control" value="@Model.NumberOfCopies" />
    </div>

    <div class="form-group">
        <label for="IsDoubledSide">Double-Sided</label>
        <select id="IsDoubledSide" name="IsDoubledSide" class="form-control">
            <option value="true" >Yes</option>
            <option value="false">No</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</form>
