@{
    ViewData["Title"] = "Home Page";
}
<link rel="stylesheet" href="/css/Home.css">
<section class="home">
    <div class="container">
        <div class="textbox">
            <div class="text" style="font-size:30px;font-weight:bold;color:black;">
                HCMSIU Student Smart Printing Service
            </div>
            <div class="text" style="font-size:20px;width:600px;margin-bottom: 40px;">
                Convenient, fast, and efficient! A service designed to help students easily manage and fulfill all printing needs across campus."
            </div>
            <a asp-controller="Printer" asp-action="Index" class="printbtn">Print now</a>
        </div>
        <div class="imgbox">
            <img src="@Url.Content("~/img/welcome.png")" class="imgwc" />
        </div>
    </div>
</section>